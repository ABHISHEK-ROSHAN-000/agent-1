{
  "name": "agent-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Agent-1: a local, approval-gated personal assistant for Windows.",
  "license": "UNLICENSED",
  "bin": {
    "agent-1": "./bin/agent-1.js"
  },
  "scripts": {
    "start": "bun run src/cli/main.ts",
    "daemon": "bun run src/daemon/main.ts",
    "typecheck": "tsc --noEmit",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:typecheck": "bun run --cwd web typecheck",
    "test": "bun test src",
    "test:unit": "bun test src",
    "test:e2e": "bun run web:build && bun test e2e",
    "test:all": "bun run check && bun run test:e2e",
    "check": "bun run typecheck && bun run web:typecheck && bun test src"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.87",
    "@effect/sql": "0.52.1",
    "@effect/sql-sqlite-bun": "4.1.2",
    "ai": "7.0.166",
    "effect": "4.1.2",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.7"
  }
}
